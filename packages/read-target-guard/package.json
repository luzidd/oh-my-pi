{
	"type": "module",
	"name": "@oh-my-pi/read-target-guard",
	"version": "0.1.0",
	"description": "Oh My Pi extension that prompts before read-like tools leave cwd or access network schemes",
	"homepage": "https://omp.sh",
	"author": "Derek Rynd",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/read-target-guard"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"keywords": [
		"security",
		"privacy",
		"approval",
		"extension",
		"agent"
	],
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "^16"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	]
}
